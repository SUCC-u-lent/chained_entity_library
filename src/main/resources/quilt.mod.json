{
	"schema_version": 1,
	"quilt_loader": {
		"group": "${group}",
		"id": "multibossbar",
		"version": "${version}",
		"metadata": {
			"name": "Multibossbar Library",
			"description": "Allows multiple boss bars to be displayed cleanly at the same time.",
			"contributors": {
				"Ubunifu": "Owner"
			},
			"contact": {
				"homepage": "https://example.com/",
				"issues": "https://github.com/QuiltMC/quilt-template-mod/issues",
				"sources": "https://github.com/QuiltMC/quilt-template-mod"
			},
			"icon": "assets/multibossbar/icon.png"
		},
		"intermediate_mappings": "net.fabricmc:intermediary",
		"entrypoints": {
			"init": "com.ubunifu.multibossbar.common.MultibossbarMod",
			"client": "com.ubunifu.multibossbar.client.ClientMultibossbarMod"
		},
		"depends": [
			{
				"id": "quilt_loader",
				"versions": ">=0.19.1"
			},
			{
				"id": "quilted_fabric_api",
				"versions": ">=7.0.2"
			},
			{
				"id": "minecraft",
				"versions": ">=1.20.6"
			}
		]
	},
	"mixin": [
		"multibossbar.mixins.json",
		"client.multibossbar.mixins.json"
	]
}
